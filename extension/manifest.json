{
  "manifest_version": 3,
  "name": "Manga Live Reader",
  "version": "0.3.0",
  "description": "만화 뷰어 화면을 캡처해 자기 mtl-service 로 보내고 번역을 그 위에 겹쳐 보인다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8788/*",
    "http://localhost:8788/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "이 페이지 번역 (Alt+Shift+M)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "read-page": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "현재 페이지를 캡처해 번역한다"
    },
    "select-region": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "읽을 영역을 드래그로 고른다 (자동 탐지 실패용)"
    },
    "refresh-page": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "이 페이지의 캐시를 지우고 다시 번역한다"
    },
    "speak-page": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "원문을 읽기 순서대로 소리내어 읽는다"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js",
        "select.js",
        "panel.js",
        "speak.js",
        "boxes.js",
        "auto.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
